# ============================================================
#  Nthakayathu Cooperative – Environment Variables
#  Copy this file to .env and fill in real values.
#  NEVER commit your real .env file to git.
# ============================================================

# MongoDB Atlas connection string.
# In Atlas: Database > Connect > Drivers > copy the connection string,
# then replace <username>, <password> and add a database name (e.g. nthakayathu).
# Example:
# MONGODB_URI=mongodb+srv://coopAdmin:YourPassword@cluster0.abcde.mongodb.net/nthakayathu?retryWrites=true&w=majority
MONGODB_URI=

# Secret used to sign JWT auth tokens. Use a long random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Port the server listens on (Render sets this automatically in production).
PORT=3000

# Optional: bcrypt salt rounds for password hashing (higher = slower but more secure)
BCRYPT_SALT_ROUNDS=10

# Optional: comma-separated list of allowed CORS origins in production.
# Leave empty to allow all origins (fine for same-origin deployment on Render).
# CORS_ORIGIN=https://your-frontend-domain.com
